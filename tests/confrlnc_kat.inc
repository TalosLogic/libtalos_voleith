/* data[1][5] joins postperm[22],[23] = (0x2, 0x3): 0x23 (paper prints 0x25). */
static const uint16_t kat1_data[KAT1_M * KAT1_L_COLS] = {
    0x12, 0xef, 0x2c, 0x37, 0x4b, 0x1c,
    0x89, 0x77, 0xd0, 0x2b, 0x3b, 0x23,
    0x3f, 0x12, 0x71, 0x7b, 0x1e, 0xba,
    0xc0, 0x79, 0x77, 0xd7, 0x29, 0xb6,
