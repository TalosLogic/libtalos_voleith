/*
 * Scheme 2 (Figures 3-4).  Same P and L as scheme 1 (reuse kat1_P / kat1_L).
 * The precode is the RREF reduction RREF([L | P]) = [I_m | C], i.e. C = L^{-1}.P
 * (the figure labels this first arrow "RLNC decoding").  The remaining stages
 * (T split, permutation, T^{-1} join) match scheme 1's structure exactly; only
 * the values differ.  The PRNG-sync symbol n and the recoded M_R matrices are
 * not reproducible from the figures and are not KAT inputs (see the KAT doc).
 *
 *   kat2_precode  4x6   precode output C = L^{-1}.P  (Fig 3)
 *   kat2_postT    4x12  after T (nibble split, high nibble first)
 *   kat2_postperm 4x12  after the partial permutation
 *   kat2_data     4x6   after T^{-1} = the M_C data block
 *
 * Self-consistency check (test-side, multiply-only): L . kat2_precode == kat1_P
 * over GF(2^8)/0x11D recovers the plaintext, validating the Fig 3 transcription
 * without a custom-poly matrix inverse.
 */
static const uint16_t kat2_precode[KAT1_M * KAT1_L_COLS] = {
    0xb4, 0x09, 0x6a, 0x48, 0xad, 0x3f,
    0xdb, 0x87, 0x7f, 0x0c, 0xbb, 0x32,
    0x59, 0x06, 0x91, 0x41, 0x95, 0xca,
    0x60, 0x69, 0x20, 0x0e, 0xfa, 0x81,
};

