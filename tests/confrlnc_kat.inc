 * confrlnc_kat.inc - Confidential RLNC (paper 2) known-answer vectors.
 *
 * Transcribed from Brahimi & Merazka 2022, Figure 1 (scheme 1 encryption).
 * See docs/private/CONFIDENTIAL_RLNC_PAPER2_KAT.md for the full transcription
 * and the self-consistency analysis.  Figure 2 (decryption) reproduces these
 * same stages in reverse, so it needs no separate vectors.  Scheme 2
 * (Figures 3-4) is added by T7.4.
 *
 * Configuration: q1 = 256 (GF(2^8)), q2 = 16, t = 2, r = 4 (nibble split).
 * The coding field poly is 0x11D (the Rijndael 0x11B does NOT reproduce the
 * figure; determined empirically, see test_poly_determination).  Values are
 * stored as uint16_t (low byte for GF(2^8) elements / low nibble for the
 * sub-symbol grid) so they feed the field-parametric codec directly.
 *
 * Stage matrices (all row-major):
 *   P        4x6   plaintext
 *   L        4x4   secret local encoding matrix
 *   C        4x6   after RLNC encode  C = L . P   (over GF(2^8), poly 0x11D)
 *   postT    4x12  after T (nibble split, high nibble first)
 *   postperm 4x12  after the partial permutation
 *   data     4x6   after T^{-1} (nibble join) = the M_C data block
 */

#define KAT1_M 4u       /* rows (generation size) */
#define KAT1_L_COLS 6u  /* coding elements per symbol */
#define KAT1_T 2u       /* sub-symbols per element */
#define KAT1_GRID 48u   /* KAT1_M * KAT1_L_COLS * KAT1_T */

static const uint16_t kat1_P[KAT1_M * KAT1_L_COLS] = {
    0x3d, 0x85, 0xae, 0x0a, 0x1a, 0x23,
    0x76, 0x3c, 0x65, 0xe2, 0x43, 0xb8,
    0xf6, 0x7d, 0x5e, 0xe9, 0x56, 0x1c,
    0x8c, 0xa0, 0xfc, 0xcc, 0xae, 0xa7,
};

static const uint16_t kat1_L[KAT1_M * KAT1_M] = {
    0x9a, 0x4c, 0x16, 0xed,
    0xb6, 0x52, 0x43, 0xbb,
    0x39, 0x6d, 0xcd, 0x7d,
    0x1e, 0x82, 0x08, 0x94,
};

/*
 * C = L.P over GF(2^8)/0x11D.  CORRECTED from the paper: Figure 1 PRINTS cell
 * (row 2, col 0) as 0x5F, but the actual L.P is 0x3F (verified independently:
 * the rest of row 2 and all of column 0 reproduce L.P, so both L and P are
 * right).  A KAT must hold the correct answer, so we use 0x3F and propagate the
 * correction through the later stages below.  The paper printed the typo'd 0x5F
 * consistently through post-T / post-perm / data, so exactly one nibble changes
 * in each of those (postT[24], postperm[23]) and one byte in data ([1][5]); all
 * other 47/48 grid positions remain verbatim from the figure.
 */
static const uint16_t kat1_C[KAT1_M * KAT1_L_COLS] = {
    0xe7, 0x07, 0x29, 0xc3, 0x12, 0x1c,
    0x86, 0xf1, 0x90, 0x72, 0x3b, 0xd7,
    0x3f, 0x23, 0x71, 0xe2, 0xbb, 0x2c, /* [2][0] = L.P (paper misprints 0x5F) */
    0x79, 0xb7, 0x4b, 0xdb, 0x1a, 0x77,
};

/* postT[24] = high nibble of C[2][0]: 0x3 (paper prints 0x5, the typo). */
static const uint16_t kat1_postT[KAT1_GRID] = {
    0xe, 0x7, 0x0, 0x7, 0x2, 0x9, 0xc, 0x3, 0x1, 0x2, 0x1, 0xc,
    0x8, 0x6, 0xf, 0x1, 0x9, 0x0, 0x7, 0x2, 0x3, 0xb, 0xd, 0x7,
    0x3, 0xf, 0x2, 0x3, 0x7, 0x1, 0xe, 0x2, 0xb, 0xb, 0x2, 0xc,
    0x7, 0x9, 0xb, 0x7, 0x4, 0xb, 0xd, 0xb, 0x1, 0xa, 0x7, 0x7,
};

/* postperm[23] receives postT[24]: 0x3 (paper prints 0x5, the typo). */
static const uint16_t kat1_postperm[KAT1_GRID] = {
