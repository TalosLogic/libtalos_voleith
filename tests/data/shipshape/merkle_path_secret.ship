# Merkle path verification with SECRET directions (bit-typed selectors).
# Used for ring-signature-style proofs where the leaf index is hidden.  Each
# level's direction is a witness bit; a per-byte MUX selects the (left,right)
# order so the path shape leaks nothing.  H(L,R) = AES_L(R) as before.
.shipshape 1
field GF(2^8) irreducible 0x11B
stdlib crypto-v1

# Keyed compression H(left, right) = AES_left(right).
subcircuit user/compress (%left : byte[16], %right : byte[16]) -> (%out : byte[16]) {
stdlib/crypto/aes/encrypt_128(%left, %right) -> %out
}

# One Merkle step.  dir = 0: current is left, sibling is right.
# dir = 1: sibling is left, current is right.  MUX sel a b picks a when
# sel = 0 and b when sel = 1.
subcircuit user/step (%cur : byte[16], %sib : byte[16], %dir : bit) -> (%out : byte[16]) {
MUX %dir %cur[0] %sib[0] -> %l0
MUX %dir %cur[1] %sib[1] -> %l1
MUX %dir %cur[2] %sib[2] -> %l2
MUX %dir %cur[3] %sib[3] -> %l3
MUX %dir %cur[4] %sib[4] -> %l4
MUX %dir %cur[5] %sib[5] -> %l5
MUX %dir %cur[6] %sib[6] -> %l6
MUX %dir %cur[7] %sib[7] -> %l7
MUX %dir %cur[8] %sib[8] -> %l8
MUX %dir %cur[9] %sib[9] -> %l9
MUX %dir %cur[10] %sib[10] -> %l10
MUX %dir %cur[11] %sib[11] -> %l11
MUX %dir %cur[12] %sib[12] -> %l12
MUX %dir %cur[13] %sib[13] -> %l13
MUX %dir %cur[14] %sib[14] -> %l14
MUX %dir %cur[15] %sib[15] -> %l15
MUX %dir %sib[0] %cur[0] -> %r0
MUX %dir %sib[1] %cur[1] -> %r1
MUX %dir %sib[2] %cur[2] -> %r2
MUX %dir %sib[3] %cur[3] -> %r3
MUX %dir %sib[4] %cur[4] -> %r4
MUX %dir %sib[5] %cur[5] -> %r5
MUX %dir %sib[6] %cur[6] -> %r6
MUX %dir %sib[7] %cur[7] -> %r7
MUX %dir %sib[8] %cur[8] -> %r8
MUX %dir %sib[9] %cur[9] -> %r9
MUX %dir %sib[10] %cur[10] -> %r10
MUX %dir %sib[11] %cur[11] -> %r11
MUX %dir %sib[12] %cur[12] -> %r12
MUX %dir %sib[13] %cur[13] -> %r13
MUX %dir %sib[14] %cur[14] -> %r14
MUX %dir %sib[15] %cur[15] -> %r15
user/compress(%l0 ++ %l1 ++ %l2 ++ %l3 ++ %l4 ++ %l5 ++ %l6 ++ %l7 ++ %l8 ++ %l9 ++ %l10 ++ %l11 ++ %l12 ++ %l13 ++ %l14 ++ %l15, %r0 ++ %r1 ++ %r2 ++ %r3 ++ %r4 ++ %r5 ++ %r6 ++ %r7 ++ %r8 ++ %r9 ++ %r10 ++ %r11 ++ %r12 ++ %r13 ++ %r14 ++ %r15) -> %out
}

WITNESS -> %leaf : byte[16]
WITNESS -> %sib0 : byte[16]
WITNESS -> %sib1 : byte[16]
WITNESS -> %dir : bit[2]
INSTANCE -> %root : byte[16]

user/step(%leaf, %sib0, %dir[0]) -> %n0
user/step(%n0, %sib1, %dir[1]) -> %n1

ASSERT_EQUAL %n1[0] %root[0]
ASSERT_EQUAL %n1[1] %root[1]
ASSERT_EQUAL %n1[2] %root[2]
ASSERT_EQUAL %n1[3] %root[3]
ASSERT_EQUAL %n1[4] %root[4]
ASSERT_EQUAL %n1[5] %root[5]
ASSERT_EQUAL %n1[6] %root[6]
ASSERT_EQUAL %n1[7] %root[7]
ASSERT_EQUAL %n1[8] %root[8]
ASSERT_EQUAL %n1[9] %root[9]
ASSERT_EQUAL %n1[10] %root[10]
ASSERT_EQUAL %n1[11] %root[11]
ASSERT_EQUAL %n1[12] %root[12]
ASSERT_EQUAL %n1[13] %root[13]
ASSERT_EQUAL %n1[14] %root[14]
ASSERT_EQUAL %n1[15] %root[15]
